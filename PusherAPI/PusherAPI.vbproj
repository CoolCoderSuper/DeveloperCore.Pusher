<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PusherAPI</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
	</ItemGroup>

  <!-- PusherAPI is also consumed by TrackForge.Api. Its host-specific settings
       must not be included when that parent application is published. -->
  <ItemGroup Condition="'$(ExcludeAppSettingsFromPublish)' == 'true'">
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
